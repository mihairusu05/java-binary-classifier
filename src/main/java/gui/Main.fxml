<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <Label text="Classification app" BorderPane.alignment="CENTER" />
   </top>
   <center>
      <HBox alignment="CENTER" fillHeight="false" prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleKNN" prefHeight="91.0" prefWidth="112.0" text="KNN-Clasification" wrapText="true" />
            <Button mnemonicParsing="false" onAction="#handleBayes" prefHeight="92.0" prefWidth="152.0" text="Naive Bayes Clasification" />
            <Button mnemonicParsing="false" prefHeight="94.0" prefWidth="127.0" text="Linear Regression" />
         </children>
      </HBox>
   </center>
   <right>
      <ComboBox fx:id="chooseData" prefWidth="150.0" promptText="Select a dataset" BorderPane.alignment="CENTER" />
   </right>
   <bottom>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="58.0" prefWidth="118.0" text="Select Train/Test percentage(Select value between 0-1) " wrapText="true" />
            <TextField fx:id="percentage" prefHeight="55.0" prefWidth="150.0" text="0.8" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
