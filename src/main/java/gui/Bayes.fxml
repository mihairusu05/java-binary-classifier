<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <Label text="This is the Bayes Classifier" BorderPane.alignment="CENTER" />
    </top>
    <bottom>
        <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#trainTestRunBayes" prefHeight="56.0" prefWidth="110.0" text="Train&amp;Test" />
            </children>
        </HBox>
    </bottom>
    <left>
        <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="41.0" prefWidth="50.0" text="Stats :" />
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Label prefHeight="34.0" prefWidth="69.0" text="Accuracy : " />
                        <Label fx:id="showAccuracy" prefHeight="18.0" prefWidth="53.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
</BorderPane>
