               </children>
            </HBox>
            <HBox prefHeight="19.0" prefWidth="100.0">
               <children>
                  <Label prefHeight="18.0" prefWidth="54.0" text="Recall:" />
                  <Label fx:id="recall" prefHeight="18.0" prefWidth="76.0" />
               </children>
            </HBox>
            <Label text="Confusion Matrix : " />
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="1">
                     <children>
                        <Label prefHeight="18.0" prefWidth="86.0" text="True Positive :  " />
                        <Label fx:id="truePositive" prefHeight="18.0" prefWidth="47.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="False Negative : " />
                        <Label fx:id="falseNegative" prefHeight="18.0" prefWidth="54.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="False Positive : " />
                        <Label fx:id="falsePositive" prefHeight="18.0" prefWidth="64.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label text="True Negative : " />
                        <Label fx:id="trueNegative" prefHeight="18.0" prefWidth="60.0" />
                     </children>
                  </HBox>
               </children>
            </GridPane>
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Hyperparams" />
            <HBox prefHeight="21.0" prefWidth="313.0">
               <children>
                  <Label prefHeight="26.0" prefWidth="82.0" text="Choose K : " />
                  <TextField fx:id="getK" prefHeight="56.0" prefWidth="150.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
